eft":"0","isLinked":false},"text_color":"#3E3E3E","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size_mobile":{"unit":"px","size":20,"sizes":[]},"typography_font_weight":"400","typography_line_height_mobile":{"unit":"em","size":1.3,"sizes":[]},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"61a21432","settings":{"content_width":"full","width":{"unit":"%","size":77,"sizes":[]},"flex_direction":"column","margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"padding_mobile":{"unit":"px","top":"0","right":"10","bottom":"0","left":"10","isLinked":false}},"elements":[{"id":"732629c","settings":{"title":"\u201cMeu marido tem 63 anos e quer transar o tempo todo, EU N\u00c3O AGUENTO MAIS!\u201d","align_mobile":"left","title_color":"#A80000","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size_mobile":{"unit":"px","size":25,"sizes":[]},"typography_font_weight":"800","typography_line_height_mobile":{"unit":"em","size":1.3,"sizes":[]},"_margin_mobile":{"unit":"px","top":"10","right":"0","bottom":"0","left":"0","isLinked":false},"typography_font_size":{"unit":"px","size":36,"sizes":[]}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"793ed481","settings":{"video_type":"hosted","youtube_url":"https:\/\/www.youtube.com\/watch?v=XHOmBV4js_E","vimeo_url":"https:\/\/vimeo.com\/235215203","dailymotion_url":"https:\/\/www.dailymotion.com\/video\/x6tqhqb","hosted_url":{"url":"http:\/\/noticias24h.fun\/wp-content\/uploads\/2025\/04\/M2.mp4","id":1068,"size":"","alt":"","source":"library"},"videopress_url":"https:\/\/videopress.com\/v\/ZCAOzTNk","autoplay":"yes","play_on_mobile":"yes","mute":"yes","loop":"yes","controls":"","aspect_ratio":"11","_border_radius":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true}},"elements":[],"isInner":false,"widgetType":"video","elType":"widget"},{"id":"63f4ee1e","settings":{"editor":"<p>Em seu processo judicial, Amanda relata que durante os primeiros anos de casamento, seu marido enfrentava alguns problemas sexuais, que desgastaram o relacionamento.<\/p><p><b>Roberto sofria com a im<span class=\"cripto\">p\u043et\u00ean\u0441\u0456\u0430<\/span>\u00a0<span class=\"cripto\">\u0455\u0435\u0445u\u0430l<\/span>\u00a0e seu\u00a0<span class=\"cripto\">\u0440\u00ean\u0456\u0455<\/span>\u00a0tinha menos de 13 cm<\/b>, o que deixava Amanda insatisfeita. Para tentar manter seu casamento, ele passou a usar diversos\u00a0<span class=\"cripto\">tr\u0430t\u0430m\u0435nt\u043e<\/span>s, mas por conta da diabetes e hipertens\u00e3o, nenhum teve os efeitos desejados.<\/p><p>A situa\u00e7\u00e3o mudou quando Roberto passou a utilizar um\u00a0<b><span class=\"cripto\">\u0422r\u0430t\u0430m\u0435nt\u043e<\/span>\u00a0Brasileiro, que aumentava a\u00a0<span class=\"cripto\">p\u043et\u00ean\u0441\u0456\u0430<\/span>\u00a0e o\u00a0<span class=\"cripto\">t\u0430m\u0430nh\u043e<\/span>\u00a0do\u00a0<span class=\"cripto\">\u0440\u00ean\u0456\u0455<\/span><\/b>. O\u00a0<span class=\"cripto\">r\u0435\u0455ult\u0430d\u043e<\/span>\u00a0disso foi que ele passou a querer\u00a0<span class=\"cripto\">tr\u0430n\u0455\u0430r<\/span>\u00a0o tempo todo.<\/p>","align_mobile":"left","_margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"text_color":"#3E3E3E","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size_mobile":{"unit":"px","size":20,"sizes":[]},"typography_font_weight":"400","typography_line_height_mobile":{"unit":"em","size":1.3,"sizes":[]},"_margin":{"unit":"px","