boquete, mas antes de eu conhecer o ELEFANTOL meu pau era bem pequeno e minha esposa conseguia colocar at\u00e9 os ovos na boca. Hoje estou concluindo o sexto m\u00eas de tratamento e meu pau cresceu tanto que ela se engasga antes de chegar no final dele. Ela n\u00e3o pode nem sonhar que tirei essa foto, se n\u00e3o me mata kakaka.<\/p>","align_mobile":"left","_margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"text_color":"#3E3E3E","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size_mobile":{"unit":"px","size":17,"sizes":[]},"typography_font_weight":"400","typography_line_height_mobile":{"unit":"em","size":1.3,"sizes":[]},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"1fa1144f","settings":{"content_width":"full","flex_direction":"row","flex_gap":{"column":"0","row":"0","isLinked":false,"unit":"px","size":0},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"68fd0131","settings":{"html":"<!-- BOT\u00c3O DE LIKE COMPLETO - FUNCIONAL -->\r\n<div class=\"like-button-component\">\r\n    <!-- \u00cdcones do Font Awesome -->\r\n    <link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.4.2\/css\/all.min.css\">\r\n    \r\n    <!-- Bot\u00e3o HTML -->\r\n    <button class=\"like-button\" data-initial-count=\"586\"> <!-- Altere este n\u00famero -->\r\n        <i class=\"like-icon far fa-thumbs-up\"><\/i>\r\n        <span class=\"like-count\">586<\/span> <!-- Mantenha igual ao data-initial-count -->\r\n    <\/button>\r\n\r\n    <script>\r\n    (function() {\r\n        \/\/ Elementos do DOM\r\n        const button = document.currentScript.parentElement.querySelector('.like-button');\r\n        const icon = button.querySelector('.like-icon');\r\n        const counter = button.querySelector('.like-count');\r\n        const initialCount = parseInt(button.dataset.initialCount) || 0;\r\n        \r\n        \/\/ ID \u00fanico baseado na posi\u00e7\u00e3o do componente na p\u00e1gina\r\n        const buttons = document.querySelectorAll('.like-button');\r\n        const buttonId = Array.from(buttons).indexOf(button);\r\n        const storageKey = `likeButton_${buttonId}`;\r\n        \r\n        \/\/ Estado inicial\r\n        let state = JSON.parse(localStorage.getItem(storageKey)) || {\r\n            count: initialCount,\r\n            liked: false\r\n        };\r\n        \r\n        \/\/ Atualizar exibi\u00e7\u00e3o\r\n        function updateDisplay() {\r\n            counter.textContent = state.count;\r\n            if (state.liked) {\r\n                icon.classList.replace('far', 'fas');\r\n                icon.classList.add('liked');\r\n            } else {\r\n                icon.classList.replace('fas', 'far');\r\n                icon.classList.remove('liked');\r\n            }\r\n        }\r\n        \r\n        \/\/ Evento de clique\r\n        button.addEventListener('click', function() {\r\n            if (state.liked) {\r\n                \/\/ J\u00e1 curtiu - remover like\r\n                state.count--;\r\n                state.liked = false;\r\n            } else {\r\n                \/\/ Ainda n\u00e3o curtiu - adicionar like\r\n                state.count++;\r\n                state.liked = true;\r\n            }\r\n            \r\n            \/\/ Salvar e atualizar\r\n            localStorage.setItem(storageKey, JSON.stringify(state));\r\n            updateDisplay();\r\n            \r\n            \/\/ Efeito visual\r\n            icon.style.transform = 'scale(1.2)';\r\n            setTimeout(() => {\r\n                icon.style.transform = 'scale(1)';\r\n            }, 200);\r\n        });\r\n        \r\n        \/\/ Inicializar\r\n        updateDisplay();\r\n    })();\r\n    <\/script>\r\n\r\n    <style>\r\n    .like-button-component {\r\n        display: inline-block;\r\n        margin: 5px;\r\n    }\r\n    \r\n    .like-button {\r\n        border: none;\r\n        padding: 8px 15px;\r\n        font-size: 15px;\r\n        cursor: pointer;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        gap: 8px;\r\n        background-color: #f5f5f5;\r\n        border-radius: 20px;\r\n        transition: all 0.2s ease;\r\n        outline: none;\r\n    }\r\n    \r\n    .like-button:hover {\r\n        background-color: #e0e0e0;\r\n    }\r\n    \r\n    .like-icon {\r\n        font-size: 18px;\r\n        transition: all 0.2s ease;\r\n        color: #666;\r\n    }\r\n    \r\n    .like-count {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 14px;\r\n        color: #333;\r\n    }\r\n    \r\n    .liked {\r\n        color: #1877f2 !important; \/* Cor quando curtido *\/\r\n    }\r\n    \r\n    .like-button:active .like-icon {\r\n        transform: scale(1.1);\r\n    }\r\n    <\/style>\r\n<\/div>","_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"},{"id":"7114c621","settings":{"title":"H\u00e1 10 horas","align":"right","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size":{"unit":"px","size":15,"sizes":[]},"typography_font_weight":"400","typography_text_transform":"uppercase","title_color":"#ADADAD","_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding":{"unit":"px","top":"5","right":"0","bottom":"5","left":"0","isLinked":false},"_element_width":"inherit","_flex_align_self":"flex-end"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"contai