ight":"0","bottom":"0","left":"0","isLinked":false},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding_mobile":{"unit":"px","top":"0","right":"0","bottom":"5","left":"0","isLinked":false}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"127759c6","settings":{"image":{"id":1171,"url":"http:\/\/noticias24h.fun\/wp-content\/uploads\/2025\/04\/Design-sem-nome-2025-04-02T194058.795-1.jpg","alt":"","source":"library","size":""},"image_size":"full","align_mobile":"center","caption":"gjjgkgkkhkg","width_mobile":{"unit":"%","size":100,"sizes":[]},"_margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"10","left":"0","isLinked":false},"_padding_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_border_border":"none","_border_radius_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"align":"center","width":{"unit":"%","size":100,"sizes":[]},"image_border_radius":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true},"image_border_radius_mobile":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding":{"unit":"px","top":"10","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[],"isInner":false,"widgetType":"image","elType":"widget"},{"id":"42abf0d5","settings":{"editor":"<p>Meu sonho sempre foi comer o cuzinho da minha namorada, mas nunca conseguia, minha rola era pequena e fina e toda vez que eu tenta comer o cuzinho dela nem fazia efeito, ate que uma amiga dela falou desse ELEFANTOL pra ela e ent\u00e3o ela comprou e come\u00e7ou a me dar escondido no suco, minha rola come\u00e7ou crescer e a engrossar, e sempre que eu comentava ela ficava rindo toda sonsa, ai s\u00f3 dps de 5 meses com ela me dando o ELEFANTOL escondido no suco minha rola dobrou de tamanho e grossura e eu falei que n\u00e3o sabia o que estava acontecendo, que poderia ser doen\u00e7a e que eu iria ir ao medico, foi ai ent\u00e3o que ela me falou kkkkk, eu fiquei muito feliz no final, agora estou descontando todo atrasso no cuzinho abertado dela.\u00a0<\/p>","align_mobile":"left","_margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"text_color":"#3E3E3E","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size_mobile":{"unit":"px","size":17,"sizes":[]},"typography_font_weight":"400","typography_line_height_mobile":{"unit":"em","size":1.3,"sizes":[]},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"56136a24","settings":{"content_width":"full","flex_direction":"row","flex_gap":{"column":"0","row":"0","isLinked":false,"unit":"px","size":0},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"ac67d9","settings":{"html":"<!-- BOT\u00c3O DE LIKE COMPLETO - FUNCIONAL -->\r\n<div class=\"like-button-component\">\r\n    <!-- \u00cdcones do Font Awesome -->\r\n    <link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.4.2\/css\/all.min.css\">\r\n    \r\n    <!-- Bot\u00e3o HTML -->\r\n    <button class=\"like-button\" data-initial-count=\"381\"> <!-- Altere este n\u00famero -->\r\n        <i class=\"like-icon far fa-thumbs-up\"><\/i>\r\n        <span class=\"like-count\">381<\/span> <!-- Mantenha igual ao data-initial-count -->\r\n    <\/button>\r\n\r\n    <script>\r\n    (function() {\r\n        \/\/ Elementos do DOM\r\n        const button = document.currentScript.parentElement.querySelector('.like-button');\r\n        const icon = button.querySelector('.like-icon');\r\n        const counter = button.querySelector('.like-count');\r\n        const initialCount = parseInt(button.dataset.initialCount) || 0;\r\n        \r\n        \/\/ ID \u00fanico baseado na posi\u00e7\u00e3o do componente na p\u00e1gina\r\n        const buttons = document.querySelectorAll('.like-button');\r\n        const buttonId = Array.from(buttons).indexOf(button);\r\n        const storageKey = `likeButton_${buttonId}`;\r\n        \r\n        \/\/ Estado inicial\r\n        let state = JSON.parse(localStorage.getItem(storageKey)) || {\r\n            count: initialCount,\r\n            liked: false\r\n        };\r\n        \r\n        \/\/ Atualizar exibi\u00e7\u00e3o\r\n        function updateDisplay() {\r\n            counter.textContent = state.count;\r\n            if (state.liked) {\r\n                icon.classList.replace('far', 'fas');\r\n                icon.classList.add('liked');\r\n            } else {\r\n                icon.classList.replace('fas', 'far');\r\n                icon.classList.remove('liked');\r\n            }\r\n        }\r\n        \r\n        \/\/ Evento de clique\r\n        button.addEventListener('click', function() {\r\n            if (state.liked) {\r\n                \/\/ J\u00e1 curtiu - remover like\r\n                state.count--;\r\n                state.liked = false;\r\n            } else {\r\n                \/\/ Ainda n\u00e3o curtiu - adicionar like\r\n                state.count++;\r\n                state.liked = true;\r\n            }\r\n            \r\n            \/\/ Salvar e atualizar\r\n            localStorage.setItem(storageKey, JSON.stringify(state));\r\n            updateDisplay();\r\n            \r\n            \/\/ Efeito visual\r\n            icon.style.transform = 'scale(1.2)';\r\n            setTimeout(() => {\r\n                icon.style.transform = 'scale(1)';\r\n            }, 200);\r\n        });\r\n        \r\n        \/\/ Inicializar\r\n        updateDisplay();\r\n    })();\r\n    <\/script>\r\n\r\n    <style>\r\n    .like-button-component {\r\n        display: inline-block;\r\n        margin: 5px;\r\n    }\r\n    \r\n    .like-button {\r\n        border: none;\r\n        padding: 8px 15px;\r\n        font-size: 15px;\r\n        cursor: pointer;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        gap: 8px;\r\n        background-color: #f5f5f5;\r\n        border-radius: 20px;\r\n        transition: all 0.2s ease;\r\n        outline: none;\r\n    }\r\n    \r\n    .like-button:hover {\r\n        background-color: #e0e0e0;\r\n    }\r\n    \r\n    .like-icon {\r\n        font-size: 18px;\r\n        transition: all 0.2s ease;\r\n        color: #666;\r\n    }\r\n    \r\n    .like-count {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 14px;\r\n        color: #333;\r\n    }\r\n    \r\n    .liked {\r\n        color: #1877f2 !important; \/* Cor quando curtido *\/\r\n    }\r\n    \r\n    .like-button:active .like-icon {\r\n        transform: scale(1.1);\r\n    }\r\n    <\/style>\r\n<\/div>","_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"},{"id":"3a0e44a4","settings":{"title":"H\u00e1 4 horas","align":"right","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size":{"unit":"px","size":15,"sizes":[]},"typography_font_weight":"400","typography_text_transform":"uppercase","title_color":"#ADADAD","_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding":{"unit":"px","top":"5","right":"0","bottom":"5","left":"0","isLinked":false},"_element_width":"inherit","_flex_align_self":"flex-end"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"},{"id":"7b10ecdc","settings":{"content_width":"full","flex_direction":"column","margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"padding_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"310d5fc3","settings":{"title":"ATEN\u00c7\u00c3O: Se voc\u00ea ainda est\u00e1 em d\u00favida sobre os resultados, a culpa n\u00e3o \u00e9 sua.","align_mobile":"left","title_color":"#A80000","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size_mobile":{"unit":"px","size":25,"sizes":[]},"typography_font_weight":"800","typography_line_height_mobile":{"unit":"em","size":1.3,"sizes":[]},"_margin_mobile":{"unit":"px","top":"10","right":"0","bottom":"0","left":"0","isLinked":false},"typography_font_size":{"unit":"px","size":36,"sizes":[]}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"16c4b027","settings":{"image":{"id":1123,"url":"http:\/\/noticias24h.fun\/wp-content\/uploads\/2025\/04\/Design-sem-nome-2025-04-02T144030.920-1.png","alt":"","source":"library","size":""},"image_size":"full","align_mobile":"center","caption":"gjjgkgkkhkg","width_mobile":{"unit":"%","size":100,"sizes":[]},"_margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_border_border":"none","_border_radius_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"align":"center","width":{"unit":"%","size":70,"sizes":[]},"image_border_radius":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true},"image_border_radius_mobile":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true}},"elements":[],"isInner":false,"widgetType":"image","elType":"widget"},{"id":"15d6cc3d","settings":{"editor":"<p>Tem tanto produto fajuto por a\u00ed, que o fabricante oficial do <b>ELEFANTOL\u00a0 <\/b>oferece uma Garantia Blindada. Confira a mensagem da empresa:<\/p><p>\u201cVoc\u00ea, leitor, tem direito a testar o nosso tratamento por 90 dias. Apenas d\u00ea o seu voto de confian\u00e7a e veja o poder desta subst\u00e2ncia revolucion\u00e1ria. Se dentro de 90 dias, voc\u00ea n\u00e3o estiver satisfeito com os resultados, b<span style=\"text-wrap-mode: initial; text-align: var(--text-align); font-size: var(--wp--preset--font-size--large); letter-spacing: -0.1px;\">asta mandar uma mensagem para o e-mail: suporte@elefantol.com que faremos a devolu\u00e7\u00e3o do valor que voc\u00ea pagou.<\/span><\/p><p>Isso significa que voc\u00ea n\u00e3o arrisca absolutamente nada ao testar o <b>ELEFANTOL\u00a0 <\/b>e no m\u00e1ximo trata seu problema de gra\u00e7a!<\/p><p>N\u00f3s garantimos os seus resultados com o nosso pr\u00f3prio dinheiro.<\/p>","align_mobile":"left","_margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"text_color":"#3E3E3E","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size_mobile":{"unit":"px","size":20,"sizes":[]},"typography_font_weight":"400","typography_line_height_mobile":{"unit":"em","size":1.3,"sizes":[]},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"5eaa5888","settings":{"width_mobile":{"unit":"%","size":100,"sizes":[]},"text":"Divisor","color":"#F3F3F3","weight":{"unit":"px","size":6,"sizes":[]},"gap_mobile":{"unit":"px","size":2,"sizes":[]}},"elements":[],"isInner":false,"widgetType":"divider",