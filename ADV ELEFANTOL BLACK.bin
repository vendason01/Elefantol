00bm\u200b\u0435\u200bn\u200bt\u200b\u043e<\/span>\u00a0100%\u00a0<span class=\"cripto\">\u200bn\u200b\u0430\u200bt\u200bu\u200br\u200b\u0430\u200bl<\/span>, livre de efeitos\u00a0<span class=\"cripto\">\u200b\u200b\u200b\u0441\u200b\u200b\u200b\u043e\u200b\u200b\u200bl\u200b\u200b\u200b\u0430\u200b\u200b\u200bt\u200b\u200b\u200b\u0435\u200b\u200b\u200br\u200b\u200b\u200b\u0430\u200b\u200b\u200b\u0456\u200b\u200b\u200b\u0455<\/span>,<\/p><p>Ap\u00f3s termos essa informa\u00e7\u00e3o, entramos em contato com os fabricantes, uma renomada\u00a0<b>Farmac\u00eautica Brasileira<\/b>, que nos trouxe mais informa\u00e7\u00f5es sobre esse\u00a0<span class=\"cripto\">\u200bm\u200b\u00e9\u200bt\u200b\u043e\u200bd\u200b\u043e<\/span>.<\/p>","align_mobile":"left","_margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"text_color":"#3E3E3E","typography_typography":"custom","typography_font_family":"Roboto","typography_font_size_mobile":{"unit":"px","size":20,"sizes":[]},"typography_font_weight":"400","typography_line_height_mobile":{"unit":"em","size":1.3,"sizes":[]},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"b45da58","settings":{"content_width":"full","width":{"unit":"%","size":77,"sizes":[]},"flex_direction":"column","margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"padding_mobile":{"unit":"px","top":"0","right":"10","bottom":"0","left":"10","isLinked":false}},"elements":[{"id":"4bdba3fc","settings":{"title":"Veja abaixo alguns dos benef\u00edcios oferecidos pelo\u00a0ELEFANTOL:","align_mobile":"left","title_color":"#A80000","typography_typography":"cust