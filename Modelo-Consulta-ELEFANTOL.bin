 "},{"bold":true,"text":"situação"},{"text":"..."}]}]}},{"id":"zi6jd3lquxskkvovk57fowk0","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Você pode até sair daqui agora e perder essa oportunidade de resolver o seu problema, mas tenho certeza de que quando você for fazer "},{"bold":true,"text":"sexo "},{"text":"e passar vergonha novamente, vai se lembrar dessa "},{"bold":true,"text":"oportunidade que perdeu"},{"text":"..."}]}]}},{"id":"pvj3cr3fiq7gldue4o9f6ip7","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Então, não seja "},{"bold":true,"text":"idiota "},{"text":"a esse ponto, pois você precisa resolver isso, e assim conseguir se sentir bem na hora do "},{"bold":true,"text":"sexo"},{"text":", sem precisar inventar desculpas..."}]}]}},{"id":"zavjc3xgly811u57plg1fps3","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Concorda comigo?"}]}]}},{"id":"xlqjd7qb6vr8qhtr6dsj5jaq","type":"choice input","items":[{"id":"mgizaf96fyabef5bq4j8usqd","outgoingEdgeId":"zia1w7e189d5ohuttcu5k8iq","content":"Sim"},{"id":"nnhgtwoalmnjd7ah72uzlv9b","outgoingEdgeId":"wjur7lb8lu2xyy6e1y4a5g8b","content":"Não"}]}]},{"id":"d6lrdvkpubhm97bb162ids14","title":"Group #19","graphCoordinates":{"x":2170.78,"y":1136.31},"blocks":[{"id":"if3ov0mgq4upsk0ggscou4xe","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Entendo seu ponto de vista..."}]}]}},{"id":"bweb5l3k8r97aez6vywt180k","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Mas independente disso, vou revelar para você qual é esse "},{"bold":true,"text":"tratamento"},{"text":", como "},{"bold":true,"text":"usar "},{"text":"e como "},{"bold":true,"text":"adquirir"},{"text":"..."}]}]}},{"id":"fjh0p2rvrlkim48cc7mvoywd","type":"text","content":{"richText":[{"type":"p","children":[{"text":"O nome desse "},{"bold":true,"text":"tratamento "},{"text":"é "},{"bold":true,"text":"ELEFANTOL"},{"text":"..."}]}]}},{"id":"vw581zknyzp7xzkom00nkmys","type":"t