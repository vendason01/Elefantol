q2dqsltxo0h52d86u","title":"Group #15","graphCoordinates":{"x":1430.24,"y":-1665.04},"blocks":[{"id":"a2q3yqie7zrtz4fgb712wemd","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Entendo perfeitamente..."}]}]}},{"id":"m8d60z0khxi8gfgw04u60mda","type":"text","content":{"richText":[{"type":"p","children":[{"text":"O que acontece geralmente é que a "},{"bold":true,"text":"maioria "},{"text":"desses "},{"bold":true,"text":"produtos vendidos pela internet"},{"text":" são "},{"bold":true,"text":"fraudulentos"},{"text":", e "},{"bold":true,"text":"não funcionam"},{"text":" de fato..."}]}]}},{"id":"w3j8ictto4fbbw2g1pkewm7r","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Na verdade, na maioria dos casos acabam "},{"bold":true,"text":"causando "},{"text":"efeitos "},{"bold":true,"text":"colaterais"},{"text":"..."}]}]}},{"id":"f1trjtjy30ng75i9ptd4g3ro","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Que inclusive podem "},{"bold":true,"text":"levar a morte"},{"text":"..."}]}]}},{"id":"hzqguo78rf8ot5h6fkltodyg","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Para você ter ideia, essa semana eu atendi um "},{"bold":true,"text":"paciente "},{"text":"que havia tido um "},{"bold":true,"text":"infarto "},{"text":"por tomar"},{"bold":true,"text":" "},{"text":"esse tipo de medicamento..."}]}]}},{"id":"f639j6lpusz2bq4fg66xpscb","type":"Wait","options":{"secondsToWaitFor":"1"}},{"id":"bk7jx7fk63vhw7h2kynblols","type":"image","content":{"url":"http://elefantol.com/wp-content/uploads/2024/04/Infarto-1.jpg"}},{"id":"ph3ll1k3wn7t6ll576bqa4sx","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Então se você já usou algum "},{"bold":true,"text":"agradeça "},{"text":"por não ter "},{"bold":true,"text":"perdido a vida"},{"text":"..."}]}]}},{"id":"w4ilk4htjvmks340h4bo0pl3","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Já os "},{"bold":true,"text":"viagras "},{"text":"nem se fala, "},{"bold":true,"text":"são piores ainda"},{"text":". As chances de causar um "},{"bold":true,"text":"infarto "},{"text":"é de quase "},{"bold":true,"text":"100%"},{"text":", sem contar que viciam. mais que dogra..."}]}]}},{"id":"iy1naml9a0y3knjafvywqdz0","type":"Wait","options":{"secondsToWaitFor":"1"}},{"id":"zt0281c4hu3ctibyz6ilmpr1","type":"image","content":{"url":"http://elefantol.com/wp-content/uploads/2024/04/Viagras-2-1-2.jpg"}},{"id":"kx9n42bmwylyhkwhw8f3odqx","type":"choice input","items":[{"id":"z3kj3uea0n2xlbx7quh98xek","outgoingEdgeId":"df0swor4nssfewabxe16k6nl","content":"Continuar"}]}]},{"id":"hmifhhiu4q7ttxhei8glyi6s","title":"Group #16","graphCoordinates":{"x":1802.98,"y":-1671.3},"blocks":[{"id":"sjd1tehpctmg5j3c3numrix3","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Durante mais de "},{"bold":true,"text":"10 anos"},{"text":" trabalhando na área da "},{"bold":true,"text":"saúde sexual"},{"text":", só conheci um "},{"bold":true,"text":"tratamento natural "},{"text":"que "},{"bold":true,"text":"não vicia, não causa efeitos colaterais"},{"text":", "},{"bold":true,"text":"nem possui contra indicações"},{"text":"..."}]}]}},{"id":"usb5xg82q3mps3e39vobchoa","type":"text","content":{"richText":[{"type":"p","children":[{"text":"E o mais importante, que "},{"bold":true,"text":"funciona de verdade"},{"text":"..."}]}]}},{"id":"m4cr5tt5eg3wvapb970n8yun","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Esse "},{"bold":true,"text":"tratamento "},{"text":"mencionado é a "},{"bold":true,"text":"única solução segura "},{"text":"e "},{"bold":true,"text":"eficaz "},{"text":"para "},{"bold":true,"text":"tratar "},{"text":"e "},{"bold":true,"text":"curar "},{"text":"seus "},{"bold":true,"text":"problemas sexuais "},{"text":"de forma"},{"bold":true,"text":" definitiva"},{"text":"..."}]}]}},{"id":"drz1w0e72ieff76513il8et6","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Ele"},{"bold":true,"text":" "},{"text":"ainda é "},{"bold":true,"text":"pouco conhecido no mercado brasileiro"},{"text":", e por esse motivo você "},{"bold":true,"text":"não"},{"text":" consegue "},{"bold":true,"text":"encontrá-lo"},{"text":" em "},{"bold":true,"text":"farmácias"},{"text":", nem pesquisando na "},{"bold":true,"text":"internet"},{"text":"..."}]}]}},{"id":"vl2qao05g8r6mxpv0nvs9ix6","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Eu não sei porque, mas se pararmos para analisar, tudo que é ruim e não presta a gente encontra em qualquer lugar, como as "},{"bold":true,"text":"viagras "},{"text":"e os outros produtos mencionados..."}]}]}},{"id":"gafnvmsemncvbk74qqppzbuu","type":"Wait","options":{"secondsToWaitFor":"1"}},{"id":"l95mgwt128loykct93kp5sww","type":"image","content":{"url":"http://elefantol.com/wp-content/uploads/2024/04/Vrios-produtos-fraudulentos-1.jpg"}},{"id":"sdpg7g27zrnfjntflqdj9xn7","type":"text","content":{"richText":[{"type":"p","children":[{"text":" Já algo que realmente funciona e é "},{"bold":true,"text":"seguro "},{"text":"e "},{"bold":true,"text":"eficaz "},{"text":"é difícil de encontrar..."}]}]}},{"id":"oem02d3u646ioc8ffkgxuf91","type":"text","content":{"richText":[{"type":"p","children":[{"text":"No "},{"bold":true,"text":"Brasil"},{"text":", sou o "},{"bold":true,"text":"único especialista "},{"text":"nesta área que possui conhecimento sobre esse "},{"bold":true,"text":"tratamento "},{"text":"revolucionário..."}]}]}},{"id":"hvex15tjozpwwemylvw81zs4","type":"text","content":{"richText":[{"type":"p","children":[{"text":"Por isso, posso afirmar que é o "},{"bold":true,"text":"único tratamento"},{"text":" que realmente consegue curar praticamente qualquer problema sexual de forma "},{"bold":true,"text":"segura e eficaz"},{"text":"..."}]}]}},{"id":"hcql271bg0xs75ore0n8xmg7","outgoingEdgeId":"yszqe2durye42z34iczug54u","type":"choice input","items":[{"id":"mfhnkd1zjoz4wvie43lsswaz","content":"Continuar","displayCondition":{"isEnabled":